<Window x:Class="Reverie.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Reverie"
        xmlns:controls="clr-namespace:Reverie.Controls"
        Title="Screensaver" 
        WindowStyle="None" 
        WindowState="Maximized" 
        Topmost="True" 
        Cursor="None"
        Background="Black"
        Icon="reverie_logo.ico"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseMove="Window_PreviewMouseMove">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    
    <Grid>
        <!-- Background Liquid Glows -->
        <Canvas x:Name="BackgroundCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
            <Canvas.Effect>
                <BlurEffect Radius="150" RenderingBias="Performance"/>
            </Canvas.Effect>
            <!-- Blob 1 -->
            <Path x:Name="Glow1" Data="M 500,100 C 800,50 950,300 900,500 C 850,700 650,950 400,900 C 150,850 50,650 100,400 C 150,150 200,150 500,100 Z" Width="1000" Height="1000" Stretch="Fill" Margin="-500,-500,0,0">
                <Path.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="Glow1ColorStop" Color="#77FF0055" Offset="0"/>
                        <GradientStop x:Name="Glow1MidStop" Color="#22FF0055" Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Path.Fill>
                <Path.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="Glow1Scale" ScaleX="1" ScaleY="1" CenterX="500" CenterY="500"/>
                        <RotateTransform x:Name="Glow1Rotate" Angle="0" CenterX="500" CenterY="500"/>
                        <TranslateTransform x:Name="Glow1Transform" X="0" Y="0"/>
                    </TransformGroup>
                </Path.RenderTransform>
            </Path>

            <!-- Blob 2 -->
            <Path x:Name="Glow2" Data="M 400,150 C 700,100 850,250 800,600 C 750,900 500,850 300,800 C 100,750 0,550 50,300 C 100,50 200,200 400,150 Z" Width="1000" Height="1000" Stretch="Fill" Margin="-500,-500,0,0">
                <Path.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="Glow2ColorStop" Color="#55FF0055" Offset="0"/>
                        <GradientStop x:Name="Glow2MidStop" Color="#11FF0055" Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Path.Fill>
                <Path.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="Glow2Scale" ScaleX="1" ScaleY="1" CenterX="500" CenterY="500"/>
                        <RotateTransform x:Name="Glow2Rotate" Angle="0" CenterX="500" CenterY="500"/>
                        <TranslateTransform x:Name="Glow2Transform" X="0" Y="0"/>
                    </TransformGroup>
                </Path.RenderTransform>
            </Path>

            <!-- Blob 3 -->
            <Path x:Name="Glow3" Data="M 600,200 C 900,150 850,450 700,700 C 550,950 350,900 200,800 C 50,700 100,400 150,200 C 200,0 400,250 600,200 Z" Width="1000" Height="1000" Stretch="Fill" Margin="-500,-500,0,0">
                <Path.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="Glow3ColorStop" Color="#33FF0055" Offset="0"/>
                        <GradientStop x:Name="Glow3MidStop" Color="#08FF0055" Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Path.Fill>
                <Path.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="Glow3Scale" ScaleX="1" ScaleY="1" CenterX="500" CenterY="500"/>
                        <RotateTransform x:Name="Glow3Rotate" Angle="0" CenterX="500" CenterY="500"/>
                        <TranslateTransform x:Name="Glow3Transform" X="0" Y="0"/>
                    </TransformGroup>
                </Path.RenderTransform>
            </Path>
        </Canvas>

        <!-- Content Grid -->
        <Grid Margin="80">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Side: Time and Track Info -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Name="ClockText" FontSize="140" Foreground="White" FontWeight="Bold"/>
                <TextBlock Name="DateText" FontSize="40" Foreground="#FFAAAAAA"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,80,0,0">
                    <Image Name="AlbumArtImage" Width="80" Height="80" Stretch="UniformToFill" Margin="0,0,20,0" Visibility="Collapsed">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,80,80" RadiusX="8" RadiusY="8"/>
                        </Image.Clip>
                    </Image>
                    <Grid VerticalAlignment="Center" Width="450">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <controls:MarqueeControl x:Name="TrackText" Grid.Row="0" MaxWidth="450" FontSize="28" Foreground="White" FontWeight="Bold" Height="40" HorizontalAlignment="Stretch"/>
                        <controls:MarqueeControl x:Name="ArtistText" Grid.Row="1" MaxWidth="450" FontSize="18" Foreground="#FFCCCCCC" Margin="0,5,0,0" Height="30" HorizontalAlignment="Stretch"/>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- Right Side: Lyrics Area -->
            <Grid Grid.Column="1">
                <TextBlock Name="NoTextIndicator" Text="..." FontSize="70" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="White" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
                    </TextBlock.Effect>
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1.0" Duration="0:0:1" />
                                    <DoubleAnimation Storyboard.TargetProperty="(TextBlock.Effect).(DropShadowEffect.BlurRadius)" From="10" To="40" Duration="0:0:1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>

                <controls:ParticleOrbControl x:Name="IdleOrb" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0"/>

                <ScrollViewer Name="LyricsScrollViewer" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Stretch">
                    <ItemsControl Name="LyricsItemsControl" Background="Transparent" BorderThickness="0" Margin="0,400,0,400">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Margin="0,15,0,15">
                                    <ContentControl.Template>
                                        <ControlTemplate TargetType="ContentControl">
                                            <Grid Margin="25,0,25,0" local:VsmBehavior.State="{Binding State}">
                                                  <VisualStateManager.VisualStateGroups>
                                                     <VisualStateGroup x:Name="LineStates">
                                                         <VisualState x:Name="Upcoming">
                                                             <Storyboard>
                                                                 <DoubleAnimation Storyboard.TargetName="UpcomingText" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.8"/>
                                                                 <DoubleAnimation Storyboard.TargetName="MainText" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.8"/>
                                                                 <DoubleAnimation Storyboard.TargetName="MainText" Storyboard.TargetProperty="(TextBlock.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.8"/>
                                                                 <DoubleAnimation Storyboard.TargetName="InstrumentalText" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.8"/>
                                                             </Storyboard>
                                                         </VisualState>
                                                         <VisualState x:Name="Played">
                                                             <Storyboard>
                                                                 <DoubleAnimation Storyboard.TargetName="UpcomingText" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.8"/>
                                                                 <DoubleAnimation Storyboard.TargetName="MainText" Storyboard.TargetProperty="Opacity" To="0.2" Duration="0:0:0.8"/>
                                                                 <ColorAnimation Storyboard.TargetName="MainText" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" To="#FF444444" Duration="0:0:0.8"/>
                                                                 <DoubleAnimation Storyboard.TargetName="MainText" Storyboard.TargetProperty="(TextBlock.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.8"/>
                                                                 <DoubleAnimation Storyboard.TargetName="InstrumentalText" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.8"/>
                                                             </Storyboard>
                                                         </VisualState>
                                                         <VisualState x:Name="Previous">
                                                             <Storyboard>
                                                                 <DoubleAnimation Storyboard.TargetName="UpcomingText" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.8"/>
                                                                 <DoubleAnimation Storyboard.TargetName="MainText" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.8"/>
                                                                 <ColorAnimation Storyboard.TargetName="MainText" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" To="#FFAAAAAA" Duration="0:0:0.8"/>
                                                                 <DoubleAnimation Storyboard.TargetName="MainText" Storyboard.TargetProperty="(TextBlock.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.8"/>
                                                                 <DoubleAnimation Storyboard.TargetName="InstrumentalText" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.8"/>
                                                             </Storyboard>
                                                         </VisualState>
                                                         <VisualState x:Name="Current">
                                                             <Storyboard>
                                                                 <DoubleAnimation Storyboard.TargetName="UpcomingText" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.8"/>
                                                                 <DoubleAnimation Storyboard.TargetName="MainText" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.8"/>
                                                                 <ColorAnimation Storyboard.TargetName="MainText" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" To="White" Duration="0:0:0.8"/>
                                                                 <DoubleAnimation Storyboard.TargetName="MainText" Storyboard.TargetProperty="(TextBlock.Effect).(DropShadowEffect.Opacity)" To="1.0" Duration="0:0:0.8"/>
                                                                 <DoubleAnimation Storyboard.TargetName="InstrumentalText" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.8"/>
                                                             </Storyboard>
                                                         </VisualState>
                                                     </VisualStateGroup>
                                                 </VisualStateManager.VisualStateGroups>

                                                 <!-- Regular Lyrics -->
                                                 <Grid x:Name="RegularLyricGrid" Visibility="Collapsed">
                                                     <TextBlock Name="UpcomingText" Text="{Binding Text}" FontSize="46" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#FF555555" Opacity="0.3">
                                                         <TextBlock.Effect><BlurEffect Radius="6" /></TextBlock.Effect>
                                                     </TextBlock>
                                                     
                                                     <TextBlock Name="MainText" Text="{Binding Text}" FontSize="46" FontWeight="SemiBold" TextWrapping="Wrap" Opacity="0">
                                                         <TextBlock.Foreground>
                                                             <SolidColorBrush Color="#FF444444" />
                                                         </TextBlock.Foreground>
                                                         <TextBlock.Effect>
                                                             <DropShadowEffect Color="White" BlurRadius="25" ShadowDepth="0" Opacity="0" />
                                                         </TextBlock.Effect>
                                                     </TextBlock>
                                                 </Grid>

                                                 <!-- Instrumental Marker -->
                                                 <TextBlock Name="InstrumentalText" Text="{Binding Text}" FontSize="60" Foreground="White" HorizontalAlignment="Center" Opacity="0" Visibility="Collapsed">
                                                     <TextBlock.Effect>
                                                         <DropShadowEffect Color="White" BlurRadius="30" ShadowDepth="0"/>
                                                     </TextBlock.Effect>
                                                 </TextBlock>
                                             </Grid>
                                             <ControlTemplate.Triggers>
                                                 <DataTrigger Binding="{Binding IsInstrumental}" Value="True">
                                                     <Setter TargetName="RegularLyricGrid" Property="Visibility" Value="Collapsed"/>
                                                     <Setter TargetName="InstrumentalText" Property="Visibility" Value="Visible"/>
                                                 </DataTrigger>
                                                 <DataTrigger Binding="{Binding IsInstrumental}" Value="False">
                                                     <Setter TargetName="RegularLyricGrid" Property="Visibility" Value="Visible"/>
                                                     <Setter TargetName="InstrumentalText" Property="Visibility" Value="Collapsed"/>
                                                 </DataTrigger>
                                             </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ContentControl.Template>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
            </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>