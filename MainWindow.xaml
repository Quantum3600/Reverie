<Window x:Class="Reverie.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Reverie"
        xmlns:controls="clr-namespace:Reverie.Controls"
        Title="Screensaver" 
        WindowStyle="None" 
        WindowState="Maximized" 
        Topmost="True" 
        Cursor="None"
        Background="Black"
        Icon="Assets/icon.png"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseMove="Window_PreviewMouseMove">
    
    <Grid>
        <!-- Background Glow -->
        <Ellipse Width="1000" Height="1000" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-200,-200,0,0">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#33FF0055" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Content Grid -->
        <Grid Margin="80">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Side: Time and Track Info -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Name="ClockText" FontSize="140" Foreground="White" FontWeight="Bold"/>
                <TextBlock Name="DateText" FontSize="40" Foreground="#FFAAAAAA"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,80,0,0">
                    <Image Name="AlbumArtImage" Width="80" Height="80" Stretch="UniformToFill" Margin="0,0,20,0" Visibility="Collapsed">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,80,80" RadiusX="8" RadiusY="8"/>
                        </Image.Clip>
                    </Image>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Name="TrackText" FontSize="28" Foreground="White" TextWrapping="Wrap"/>
                        <TextBlock Name="ArtistText" FontSize="18" Foreground="#FFCCCCCC" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Right Side: Lyrics Area -->
            <Grid Grid.Column="1">
                <TextBlock Name="NoTextIndicator" Text="..." FontSize="70" Foreground="#FF666666" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1.0" Duration="0:0:1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>

                <controls:ParticleOrbControl x:Name="IdleOrb" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0"/>

                <ScrollViewer Name="LyricsScrollViewer" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Stretch">
                    <ItemsControl Name="LyricsItemsControl" Background="Transparent" BorderThickness="0" Margin="0,400,0,400">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Margin="0,15,0,15">
                                    <ContentControl.Template>
                                        <ControlTemplate TargetType="ContentControl">
                                            <Grid Margin="25,0,25,0" local:VsmBehavior.State="{Binding State}">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="LineStates">
                                                        <VisualState x:Name="Upcoming">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="UpcomingText" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.8"/>
                                                                <DoubleAnimation Storyboard.TargetName="MainText" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.8"/>
                                                                <DoubleAnimation Storyboard.TargetName="MainTextGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.8"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Played">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="UpcomingText" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.8"/>
                                                                <DoubleAnimation Storyboard.TargetName="MainText" Storyboard.TargetProperty="Opacity" To="0.2" Duration="0:0:0.8"/>
                                                                <ColorAnimation Storyboard.TargetName="MainTextBrush" Storyboard.TargetProperty="Color" To="#FF444444" Duration="0:0:0.8"/>
                                                                <DoubleAnimation Storyboard.TargetName="MainTextGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.8"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Previous">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="UpcomingText" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.8"/>
                                                                <DoubleAnimation Storyboard.TargetName="MainText" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.8"/>
                                                                <ColorAnimation Storyboard.TargetName="MainTextBrush" Storyboard.TargetProperty="Color" To="#FFAAAAAA" Duration="0:0:0.8"/>
                                                                <DoubleAnimation Storyboard.TargetName="MainTextGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.8"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Current">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="UpcomingText" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.8"/>
                                                                <DoubleAnimation Storyboard.TargetName="MainText" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.8"/>
                                                                <ColorAnimation Storyboard.TargetName="MainTextBrush" Storyboard.TargetProperty="Color" To="White" Duration="0:0:0.8"/>
                                                                <DoubleAnimation Storyboard.TargetName="MainTextGlow" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.8"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <TextBlock Name="UpcomingText" Text="{Binding Text}" FontSize="46" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#FF555555" Opacity="0.3">
                                                    <TextBlock.Effect><BlurEffect Radius="6" /></TextBlock.Effect>
                                                </TextBlock>
                                                <TextBlock Name="MainText" Text="{Binding Text}" FontSize="46" FontWeight="SemiBold" TextWrapping="Wrap" Opacity="0">
                                                    <TextBlock.Foreground>
                                                        <SolidColorBrush x:Name="MainTextBrush" Color="#FF444444" />
                                                    </TextBlock.Foreground>
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect x:Name="MainTextGlow" Color="White" BlurRadius="25" ShadowDepth="0" Opacity="0" />
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                            </Grid>
                                        </ControlTemplate>
                                    </ContentControl.Template>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
            </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>