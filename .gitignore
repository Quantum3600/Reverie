## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Original source: https://github.com/github/gitignore/blob/master/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]in/
[Oo]bj/
[Log]/
[Intermediate]/

# Visual Studio 2015/2017 cache/options directory
.vs/
# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/

# Compiled files
*.dll
*.exe
*.pdb

# Core 
project.lock.json
project.fragment.lock.json
artifacts/

# StyleCop
StyleCop.Cache

# Backup & temp files from Microsoft Office
$~*
~$*

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml

# Build log of MSBuild
*.log

# VS Code folders
.vscode/

# Rider folders
.idea/

# Windows image transitions
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycled Folder
$RECYCLE.BIN/

# Others
publish/
*.nupkg
# NuGet Packages
*.nuget.props
*.nuget.targets
